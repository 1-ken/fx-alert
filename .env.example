# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=same-value-as-curencies

# Upstream observer API — used by the browser only when needed (prefer same-origin Next proxies).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional override for server-side observer URL. Usually unnecessary: Next auto-probes
# loopback :8000, then http://<public-host>:8000, then NEXT_PUBLIC_API_URL.
# OBSERVER_API_URL=

# Optional: direct WebSocket URL (otherwise resolved via /api/observer/ws-token)
# NEXT_PUBLIC_OBSERVER_WS_URL=ws://localhost:8000/ws/observe

# Firebase (optional, for custom-token sync)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
#now it is up
# Admin panel (SMS OTP) — restart dev server after changing NEXT_PUBLIC_* values
# URL: /admin/<NEXT_PUBLIC_ADMIN_PATH_SECRET>
NEXT_PUBLIC_ADMIN_PATH_SECRET=fx-admin
# Optional: pre-fill admin phone on OTP screen (must match backend ADMIN_PHONE)
# NEXT_PUBLIC_ADMIN_PHONE=+254707879716
