# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=same-value-as-curencies

# Upstream observer API (FastAPI) — used for register/login and observer proxies
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: direct WebSocket URL (otherwise resolved via /api/observer/ws-token)
# NEXT_PUBLIC_OBSERVER_WS_URL=ws://localhost:8000/ws/observe

# Firebase (optional, for custom-token sync)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
